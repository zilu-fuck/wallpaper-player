    "verify:electron-runtime": "node scripts/run-verify.cjs scripts/verify-electron-runtime.js",
    "verify:vite-dev": "node scripts/run-verify.cjs scripts/verify-vite-dev.js",
    "verify:settings-recovery": "node scripts/run-verify.cjs scripts/verify-settings-recovery.js && node scripts/run-verify.cjs scripts/verify-settings-recovery-ui.js",
