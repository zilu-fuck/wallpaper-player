    "verify:vlm-ui": "node scripts/run-verify.cjs scripts/verify-vlm-ui.js",
    "verify:analysis-settings": "node scripts/run-verify.cjs scripts/verify-analysis-settings.js",
    "verify:analysis-config": "node scripts/run-verify.cjs scripts/verify-analysis-config-store.js",
    "verify:settings-snapshots": "node scripts/run-verify.cjs scripts/verify-settings-snapshots.js && node scripts/run-verify.cjs scripts/verify-settings-snapshots-ui.js",
    "verify:settings-panels": "node scripts/run-verify.cjs scripts/verify-settings-panels.js && node scripts/run-verify.cjs scripts/verify-settings-panels-ui.js",
    "verify:app-initialization": "node scripts/run-verify.cjs scripts/verify-app-initialization.js && node scripts/run-verify.cjs scripts/verify-app-initialization-ui.js",
    "verify:privacy-passwords": "node scripts/run-verify.cjs scripts/verify-privacy-passwords.js",
    "verify:media-policy-settings": "node scripts/run-verify.cjs scripts/verify-media-policy-settings.js",
    "verify:updater-startup": "node scripts/run-verify.cjs scripts/verify-updater-startup.js",
    "verify:json-responses": "node scripts/run-verify.cjs scripts/verify-json-responses.js",
    "verify:library-paths": "node scripts/run-verify.cjs scripts/verify-library-path-resolution.js",
    "verify:responsive-layout": "node scripts/run-verify.cjs scripts/verify-responsive-layout.js",
    "verify:splash-clock": "node scripts/run-verify.cjs scripts/verify-splash-clock.js && node scripts/run-verify.cjs scripts/verify-splash-ui.js",
    "verify:mobile-accessibility": "node scripts/run-verify.cjs scripts/verify-mobile-accessibility.js",
    "verify:mobile-input-accessibility": "node scripts/run-verify.cjs scripts/verify-mobile-input-accessibility.js",
    "verify:mobile-player-panels": "node scripts/run-verify.cjs scripts/verify-mobile-player-panels.js",
    "verify:app-state": "node scripts/run-verify.cjs scripts/verify-controller-store.js && node scripts/run-verify.cjs scripts/verify-app-state.js",
    "verify:startup": "node scripts/run-verify.cjs scripts/verify-direct-startup.js",
    "verify:settings-persistence": "node scripts/run-verify.cjs scripts/verify-settings-persistence.js",
    "verify:test-data-guard": "node scripts/run-verify.cjs scripts/verify-test-data-guard.js",
    "verify:dependency-security": "node scripts/run-verify.cjs scripts/verify-dependency-security.js",
