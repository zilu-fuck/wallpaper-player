    "verify:media-access": "node scripts/run-verify.cjs scripts/verify-media-access.js",
    "verify:media-mutations": "node scripts/run-verify.cjs scripts/verify-media-mutations.js",
    "verify:media-fields": "node scripts/run-verify.cjs scripts/verify-media-fields.js",
    "verify:media-mutation-paths": "node scripts/run-verify.cjs scripts/verify-media-mutation-paths.js && node scripts/run-verify.cjs scripts/verify-media-mutation-path-lifecycle.js",
    "verify:shutdown-persistence": "node scripts/run-verify.cjs scripts/verify-shutdown-persistence.js",
    "verify:update-metadata": "node scripts/run-verify.cjs scripts/verify-update-metadata.js",
    "verify:remote-pressure": "node scripts/run-verify.cjs scripts/verify-remote-pressure.js",
    "verify:mobile-multi-device": "node scripts/run-verify.cjs scripts/verify-mobile-multi-device.js",
    "verify:mobile-correctness": "node scripts/run-verify.cjs scripts/verify-mobile-correctness.js",
    "verify:mobile-player": "node scripts/run-verify.cjs scripts/verify-mobile-player-structure.js",
    "verify:mobile-performance": "node scripts/run-verify.cjs scripts/verify-mobile-performance-budget.js",
    "verify:video-metadata": "node scripts/run-verify.cjs scripts/verify-video-metadata-cache.js",
    "verify:mobile-transcode": "node scripts/run-verify.cjs scripts/verify-transcode-command.js",
    "verify:mobile-transcode-concurrency": "node scripts/run-verify.cjs scripts/verify-transcode-concurrency.js",
    "verify:mobile-lan": "npm run verify:remote-mobile && npm run verify:remote-settings && npm run verify:remote-api && npm run verify:remote-library && npm run verify:mobile-multi-device && npm run verify:mobile-player && npm run verify:mobile-performance && npm run verify:mobile-transcode && npm run verify:mobile-transcode-concurrency",
