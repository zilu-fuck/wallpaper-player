    "verify:settings-json": "node scripts/run-verify.cjs scripts/verify-settings-json-cost.js && node scripts/run-verify.cjs scripts/verify-settings-json-lifecycle.js",
    "verify:settings-read": "node scripts/run-verify.cjs scripts/verify-settings-read-lifecycle.js && node scripts/run-verify.cjs scripts/verify-settings-read-asar.js",
    "verify:settings-startup": "node scripts/run-verify.cjs scripts/verify-settings-startup.js && node scripts/run-verify.cjs scripts/verify-settings-startup-asar.js",
    "verify:settings-feed": "node scripts/run-verify.cjs scripts/verify-settings-feed.js && node scripts/run-verify.cjs scripts/verify-settings-broadcast-lifecycle.js && node scripts/run-verify.cjs scripts/verify-settings-feed-ui.js",
    "verify:settings-replies": "node scripts/run-verify.cjs scripts/verify-settings-replies.js",
