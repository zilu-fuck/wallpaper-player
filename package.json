    "dist:win": "npm run build && npm run prepare-vendor && node scripts/package-win.js",
    "verify:release-gate": "node scripts/run-verify.cjs scripts/verify-release-gate.js",
    "verify:packaging": "node scripts/run-verify.cjs scripts/verify-packaging.js",
    "verify:mobile-updates": "node scripts/run-verify.cjs scripts/verify-mobile-updates.js",
    "verify:mobile-update-ui": "node scripts/run-verify.cjs scripts/verify-mobile-update-ui.js",
    "verify:update-context": "node scripts/run-verify.cjs scripts/verify-update-server-context.js"
  },
  "build": {
    "appId": "com.wallpaper.player",
    "productName": "Wallpaper Player",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "build/icon.png",
      "main.js",
      "main/**/*",
      "packages/contracts/package.json",
      "packages/contracts/dist/**/*",
      "packages/domain/package.json",
      "packages/domain/dist/**/*",
      "!main/plugins/video-analysis/**",
      "!main/plugins/ai-search/**",
      "!main/plugins/agent-bridge/**",
      "!main/video-comprehension-runtime/**",
      "preload.js",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "licenses/**/*",
      "sources/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor",
        "to": "vendor",
        "filter": [
          "**/*",
          "!_downloads/**",
          "!**/*.pdb",
          "!ffmpeg/doc/**",
          "!llama.cpp/**",
          "!llama.cpp-cuda/**"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "Wallpaper-Player-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "license": "LICENSE",
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "Wallpaper-Player-${version}.${ext}"
    },
    "electronUpdaterCompatibility": ">=2.16",
    "publish": [
      {
        "provider": "github",
        "owner": "zilu-fuck",
        "repo": "wallpaper-player"
      }
    ]
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.0",
    "electron-builder": "^26.15.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^6.0.3",
    "vite": "8.3.4"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "qrcode": "^1.5.4"
  },
  "optionalDependencies": {
    "playwright-core": "^1.61.1"
  }
}
