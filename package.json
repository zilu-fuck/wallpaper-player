    "verify:remote-library": "node scripts/run-verify.cjs scripts/verify-remote-library-flow.js",
    "verify:legacy-tags": "node scripts/run-verify.cjs scripts/verify-legacy-tags-path-key.js",
    "verify:thumbnail-playback": "node scripts/run-verify.cjs scripts/verify-thumbnail-playback-throttle.js",
    "verify:plugin-official": "node scripts/run-verify.cjs --electron scripts/verify-official-plugin-sync.js",
    "verify:ai-search": "node scripts/run-verify.cjs scripts/verify-ai-search.js",
    "verify:vendor": "node scripts/run-verify.cjs scripts/verify-vendor.js",
    "verify:vlm-path-migration": "node scripts/run-verify.cjs scripts/verify-installed-vlm-path-migration.js",
    "verify:vlm-installed-probe": "node scripts/run-verify.cjs scripts/probe-installed-vlm-start.js",
    "plugin:install-local-video-analysis": "node scripts/install-local-video-analysis-plugin.js",
    "qa:mobile-real-device": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/qa-mobile-real-device.ps1",
    "verify:electron-api": "node scripts/run-verify.cjs scripts/verify-electron-api-types.js && tsc --noEmit -p tsconfig.electronapi.json",
    "verify:plugins": "node scripts/run-verify.cjs scripts/verify-plugin-registry.js",
    "verify:plugin-settings": "node scripts/run-verify.cjs scripts/verify-plugin-settings-lifecycle.js",
    "verify:identity-read-safety": "node scripts/run-verify.cjs scripts/verify-identity-read-safety.js",
